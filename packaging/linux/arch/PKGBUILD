pkgrel=27
pkgdesc='Local dictation, read aloud, and screen text for Linux desktops'
arch=('x86_64')
url='https://github.com/yosef0H4/simple-stt'
license=('GPL-2.0-only' 'MIT' 'OFL-1.1' 'CC-BY-SA-3.0')
depends=('noto-fonts-emoji' 'alsa-lib' 'libx11' 'pango' 'cairo' 'pipewire' 'gcc-libs' 'glib2' 'at-spi2-core' 'systemd' 'xdg-utils' 'libsecret' 'xclip' 'wl-clipboard' 'slurp')
options=('!debug')
source=('simple-stt-stage.tar')
sha256sums=('SKIP')

package() {

    output := ""
    offset := 1
    while RegExMatch(text, "\{([a-zA-Z_]+)\}", &part, offset) {
        output .= SubStr(text, offset, part.Pos - offset)
        output .= IsSet(args) && args.Has(part[1]) ? args[part[1]] : part[0]
        offset := part.Pos + part.Len
    }
    return output . SubStr(text, offset)

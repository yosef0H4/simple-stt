UiSetLanguage(language := "auto") {
    global SimpleSttUiLocale
    if language = "auto"
        language := (DllCall("GetUserDefaultUILanguage", "UShort") & 0x3ff) = 1 ? "ar" : "en"
    SimpleSttUiLocale := language = "ar" ? "ar" : "en"
}
